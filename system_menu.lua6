-- Aplica (ou remove) o fundo do menu e marca o quadradinho escolhido
local function aplicarFundo(id)
	fundoAtual = id and idTexto(id) or nil
	if fundoAtual then
		local escolhido = fundoAtual
		fundoImg.Image = miniatura(escolhido, 150) -- aparece na hora (já carregada)
		fundoImg.Visible = true
		task.spawn(function() -- troca pela versão grande quando ela carregar
			preCarregar({miniatura(escolhido, 420)})
			if fundoAtual == escolhido then fundoImg.Image = miniatura(escolhido, 420) end
		end)
	else
		fundoImg.Image = ""
		fundoImg.Visible = false
	end
	for _, q in ipairs(quadrosFundo) do
		q.stroke.Color = (fundoAtual and q.id == fundoAtual) and COR.on or COR.azul
	end
end

