-- Cada botão da barra abre a sua página; apertando de novo (←) volta ao menu
local function mostrarPagina(nome)
	paginaAtual = nome
	for n, frame in pairs(paginas) do frame.Visible = (n == nome) end
	titulo.Text = titulos[nome]
	local bm = corpo:FindFirstChild("BarraModo")
	if bm then bm.Visible = (nome == "menu") end
	atualizarIcones()
end

-- Minimizar: a barra continua visível. Tocar em qualquer botão de página
-- com o menu minimizado abre o menu direto naquela página.
local function definirMinimizado(v)
	minimizado = v
	corpo.Visible = not v
	main.Size = UDim2.new(0, MENU.largura, 0, v and BARRA.altura or MENU.altura)
	atualizarIcones()
end

local function abrirPagina(nome)
	if minimizado then
		definirMinimizado(false)
		mostrarPagina(nome)
	else
		mostrarPagina(paginaAtual == nome and "menu" or nome)
	end
end

btnMinimizar.MouseButton1Click:Connect(function() definirMinimizado(not minimizado) end)
btnConfig.MouseButton1Click:Connect(function() abrirPagina("config") end)
btnTele.MouseButton1Click:Connect(function() abrirPagina("tele") end)
btnAjustes.MouseButton1Click:Connect(function() abrirPagina("ajustes") end)

-- Botão novo: selo de ícone (emoji ou figurinha) + texto, com degradê e espaço
local function novoBotao(ordem, pai, texto, cor, chave, emoji)
	cor = cor or COR.azul
	local btn = criar("TextButton", {
		Size = UDim2.new(1, 0, 0, 38),
		LayoutOrder = ordem,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	}, pai)
	arredondar(btn, 10)
	criar("UIStroke", {Color = cor, Thickness = 1.5, Transparency = 0.25}, btn)
	criar("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(34, 34, 56), Color3.fromRGB(20, 20, 34)),
		Rotation = 90,
	}, btn)

	local selo = criar("Frame", {
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(0, 6, 0.5, -14),
		BackgroundColor3 = cor,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
	}, btn)
	arredondar(selo, 8)
	local emojiLbl = criar("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = emoji or "",
		TextSize = 15,
		TextColor3 = COR.texto,
		Font = Enum.Font.SourceSansBold,
	}, selo)
	local img = criar("ImageLabel", {
		Size = UDim2.new(0, 20, 0, 20),
		Position = UDim2.new(0.5, -10, 0.5, -10),
		BackgroundTransparency = 1,
		Visible = false,
	}, selo)
	if chave then
		registrarIcone({alvo = emojiLbl, img = img, chave = chave, emoji = emoji or ""})
	end

	local rotulo = criar("TextLabel", {
		Size = UDim2.new(1, -48, 1, 0),
		Position = UDim2.new(0, 42, 0, 0),
		BackgroundTransparency = 1,
		Text = texto or "",
		TextColor3 = COR.texto,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.SourceSansBold,
	}, btn)

	btn.MouseButton1Click:Connect(function() efeitoClique(btn, 1.03) end)
	return btn, rotulo
end

-- Painel de categoria: cabeçalho com ícone + conteúdo. Cada botão fica na sua categoria.
-- Retorna (conteúdo, painel)
local function novoPainel(pagina, ordem, titulo, cor, chave, emoji)
	local painel = criar("Frame", {
		Size = UDim2.new(1, -6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = ordem,
		BackgroundColor3 = Color3.fromRGB(20, 20, 34),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
	}, pagina)
	arredondar(painel, 12)
	criar("UIStroke", {Color = cor, Thickness = 1, Transparency = 0.5}, painel)
	criar("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}, painel)
	criar("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	}, painel)

	local cab = criar("Frame", {
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 0,
		BackgroundColor3 = cor,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
	}, painel)
	arredondar(cab, 9)
	local faixa = criar("Frame", {
		Size = UDim2.new(0, 4, 1, -12),
		Position = UDim2.new(0, 6, 0, 6),
		BackgroundColor3 = cor,
		BorderSizePixel = 0,
	}, cab)
	arredondar(faixa, 2)
	local emojiLbl = criar("TextLabel", {
		Size = UDim2.new(0, 22, 1, 0),
		Position = UDim2.new(0, 16, 0, 0),
		BackgroundTransparency = 1,
		Text = emoji or "",
		TextSize = 14,
		TextColor3 = COR.texto,
		Font = Enum.Font.SourceSansBold,
	}, cab)
	local img = criar("ImageLabel", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(0, 18, 0.5, -9),
		BackgroundTransparency = 1,
		Visible = false,
	}, cab)
	if chave then
		registrarIcone({alvo = emojiLbl, img = img, chave = chave, emoji = emoji or ""})
	end
	criar("TextLabel", {
		Size = UDim2.new(1, -48, 1, 0),
		Position = UDim2.new(0, 42, 0, 0),
		BackgroundTransparency = 1,
		Text = titulo,
		TextColor3 = COR.texto,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.SourceSansBold,
	}, cab)

	local conteudo = criar("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		BackgroundTransparency = 1,
	}, painel)
	criar("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}, conteudo)
	return conteudo, painel
end

-- Interruptor estilo ON/OFF (pílula verde com bolinha branca / cinza)
local function novoInterruptor(ordem, pai, texto, cor, aoMudar)
	local linha = criar("TextButton", {
		Size = UDim2.new(1, 0, 0, 38),
		LayoutOrder = ordem,
		BackgroundColor3 = COR.card,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	}, pai)
	arredondar(linha, 10)
	criar("UIStroke", {Color = cor or COR.azul, Thickness = 1.5}, linha)

	criar("TextLabel", {
		Size = UDim2.new(1, -62, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		Text = texto,
		TextColor3 = COR.texto,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.SourceSansBold,
	}, linha)

	local trilho = criar("Frame", {
		Size = UDim2.new(0, 46, 0, 22),
		Position = UDim2.new(1, -52, 0.5, -11),
		BackgroundColor3 = COR.cinza,
		BorderSizePixel = 0,
	}, linha)
	arredondar(trilho, 11)

	local rotulo = criar("TextLabel", {
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.new(1, -27, 0, 0),
		BackgroundTransparency = 1,
		Text = "OFF",
		TextColor3 = COR.sub,
		TextSize = 9,
		Font = Enum.Font.SourceSansBold,
	}, trilho)

	local bola = criar("Frame", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(0, 2, 0.5, -9),
		BackgroundColor3 = COR.texto,
		BorderSizePixel = 0,
	}, trilho)
	arredondar(bola, 9)

	local ligado = false
	local function set(estado)
		if estado == ligado then return end
		ligado = estado
		local info = TweenInfo.new(0.15)
		TweenService:Create(bola, info, {
			Position = ligado and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
		}):Play()
		TweenService:Create(trilho, info, {
			BackgroundColor3 = ligado and COR.on or COR.cinza,
		}):Play()
		rotulo.Text = ligado and "ON" or "OFF"
		rotulo.Position = ligado and UDim2.new(0, 3, 0, 0) or UDim2.new(1, -27, 0, 0)
		rotulo.TextColor3 = ligado and COR.onTexto or COR.sub
	end

	linha.MouseButton1Click:Connect(function()
		set(not ligado)
		if aoMudar then aoMudar(ligado) end
	end)

	return {linha = linha, set = set}
end

-- Texto explicativo pequeno
