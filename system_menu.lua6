-- ========== ÍCONES (figurinhas) ==========
local function idTexto(id) -- evita notação científica nos IDs grandes
	return string.format("%.0f", tonumber(id))
end

local function miniatura(id, tam)
	tam = tam or 420
	return "rbxthumb://type=Asset&id=" .. idTexto(id) .. "&w=" .. tam .. "&h=" .. tam
end

-- Pré-carrega imagens (o jogo baixa antes de precisar, sem atraso na hora de mostrar)
local function preCarregar(urls)
	local CP = game:GetService("ContentProvider")
	local alvos = {}
	for _, u in ipairs(urls) do
		local img = Instance.new("ImageLabel")
		img.Name = "PreCarga"
		img.Size = UDim2.new(0, 1, 0, 1)
		img.Position = UDim2.new(-1, 0, -1, 0)
		img.BackgroundTransparency = 1
		img.ImageTransparency = 0.99
		img.Image = u
		img.Parent = gui
		table.insert(alvos, img)
	end
	pcall(function() CP:PreloadAsync(alvos) end)
end

local iconesAlvos = {}
local function valor(v)
	if type(v) == "function" then return v() end
	return v
end

-- alvo = {alvo = objeto de texto (emoji), img = ImageLabel, chave = nome ou função, emoji = texto ou função}
local function registrarIcone(a)
	table.insert(iconesAlvos, a)
end

-- Modo normal: mostra o emoji. Modo personalizado: mostra a figurinha.
local function atualizarIcones()
	for _, a in ipairs(iconesAlvos) do
		local id = ICONES[valor(a.chave)]
		local usa = iconesOn and id ~= nil
		a.img.Visible = usa
		if usa then a.img.Image = miniatura(id, 150) end
		a.alvo.Text = usa and "" or (valor(a.emoji) or "")
	end
end

