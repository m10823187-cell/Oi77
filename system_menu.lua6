-- ========== FUNÇÕES AUXILIARES ==========
-- Guarda a conexão para poder desligar tudo ao fechar o menu
local function ligar(sinal, fn)
	local c = sinal:Connect(fn)
	table.insert(conexoes, c)
	return c
end

-- Cria uma instância já com propriedades e pai
local function criar(classe, props, pai)
	local obj = Instance.new(classe)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = pai
	return obj
end

local function arredondar(obj, raio)
	criar("UICorner", {CornerRadius = UDim.new(0, raio or 8)}, obj)
end

-- Pulinho ao tocar
local function efeitoClique(obj, forca)
	local escala = obj:FindFirstChild("UIScale") or criar("UIScale", {}, obj)
	TweenService:Create(escala, TweenInfo.new(0.08), {Scale = forca or 1.1}):Play()
	task.delay(0.08, function()
		TweenService:Create(escala, TweenInfo.new(0.08), {Scale = 1}):Play()
	end)
end

-- Arrastar o menu pela barra (toque ou mouse)
local function arrastar(handle, alvo)
	local ativo, inicio, posIni = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch
			or i.UserInputType == Enum.UserInputType.MouseButton1 then
			ativo, inicio, posIni = true, i.Position, alvo.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then ativo = false end
			end)
		end
	end)
	ligar(UIS.InputChanged, function(i)
		if ativo and (i.UserInputType == Enum.UserInputType.Touch
			or i.UserInputType == Enum.UserInputType.MouseMovement) then
			local d = i.Position - inicio
			alvo.Position = UDim2.new(posIni.X.Scale, posIni.X.Offset + d.X,
				posIni.Y.Scale, posIni.Y.Offset + d.Y)
		end
	end)
end

-- Nome do jogador: se o nick for igual ao nome mostra só um
local function textoNome(plr)
	if plr.DisplayName == plr.Name then return plr.Name end
	return plr.DisplayName .. "\n@" .. plr.Name
end

-- Foto do jogador (carrega em segundo plano)
local function carregarFoto(plr, label)
	task.spawn(function()
		local ok, img = pcall(Players.GetUserThumbnailAsync, Players, plr.UserId,
			Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		if ok and label.Parent then label.Image = img end
	end)
end

-- ADMs
local function ehAdm(plr)
	return ADMS[string.lower(plr.Name)] == true
end

-- Pode ser escolhido pelos modos automáticos? (botão embaixo do quadrado)
local function podeFarmarAuto(plr)
	local v = farmavel[plr]
	if v == nil then v = not ehAdm(plr) end
	return v
end

local function getHRP(char)
	return char and char:FindFirstChild("HumanoidRootPart")
end

-- ========== BASES (lobby e segurança) ==========
local BASE_CF = CFrame.new(BASE.pos)

-- Posição dentro da base do lobby?
local function noLobby(pos)
	local p = BASE_CF:PointToObjectSpace(pos)
	local m = BASE.tamanho / 2
	return math.abs(p.X) <= m.X and math.abs(p.Y) <= m.Y and math.abs(p.Z) <= m.Z
end

-- Cria a base do lobby (apaga a anterior). Toda vez que você nasce
local function criarBase()
	if baseParte then baseParte:Destroy() end
	baseParte = criar("Part", {
		Name = "BaseLobby",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Size = BASE.tamanho,
		CFrame = BASE_CF,
		Color = BASE.cor,
		Material = Enum.Material.SmoothPlastic,
		Transparency = BASE.transparencia,
	}, workspace)
end

local function removerBaseSegura()
	if baseSegura then
		for _, parte in ipairs(baseSegura.partes) do parte:Destroy() end
		baseSegura = nil
	end
	ultimoChao = nil
	historicoChao = {}
end

-- Cria a base de segurança na posição fixa X:190 Y:390 Z:-96 (2048x5x2048),
-- mais as camadas extras logo abaixo (o ragdoll não deixa atravessar)
local function criarBaseSegura(posMapa)
	removerBaseSegura()
	local cf = CFrame.new(BASE_SEGURA.x, BASE_SEGURA.altura, BASE_SEGURA.z)
	local partes, todas = {}, {}
	for i = 0, BASE_SEGURA.camadas do
		local parte = criar("Part", {
			Name = "BaseSegura",
			Anchored = true,
			CanCollide = true, -- também segura você se cair no void
			CanQuery = true,
			CanTouch = false,
			Size = BASE_SEGURA.tamanho,
			CFrame = cf * CFrame.new(0, -i * BASE_SEGURA.tamanho.Y, 0),
			Color = BASE_SEGURA.cor,
			Material = Enum.Material.SmoothPlastic,
			Transparency = BASE_SEGURA.transparencia,
		}, workspace)
		table.insert(partes, parte)
		todas[parte] = true
	end
	baseSegura = {parte = partes[1], cf = cf, partes = partes, todas = todas}
	ultimoChao = {pos = posMapa} -- só vale até você pisar em algum lugar do mapa
end

-- Roda todo frame: cria a base de segurança ao sair do lobby,
-- guarda o último chão firme e te devolve a ele se você tocar ou ATRAVESSAR a base
local raioParams = RaycastParams.new()
raioParams.FilterType = Enum.RaycastFilterType.Exclude

-- Parte mais baixa do CORPO (só as partes do boneco; efeitos e peças do jogo não contam)
local PARTES_CORPO = {
	HumanoidRootPart = true, Head = true, Torso = true, UpperTorso = true, LowerTorso = true,
	["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
	LeftFoot = true, RightFoot = true, LeftLowerLeg = true, RightLowerLeg = true,
	LeftUpperLeg = true, RightUpperLeg = true, LeftHand = true, RightHand = true,
	LeftLowerArm = true, RightLowerArm = true, LeftUpperArm = true, RightUpperArm = true,
}

local function pontoMaisBaixo(char, hrp)
	local y = hrp.Position.Y - BASE_SEGURA.pes
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") and PARTES_CORPO[p.Name] then
			local py = p.Position.Y - p.Size.Y / 2
			if py < y then y = py end
		end
	end
	return y
end

-- Ponto de volta: um pouco ANTES do último chão (recuo em segundos)
local function pontoDeVolta()
	local n = #historicoChao
	if n == 0 then return ultimoChao and ultimoChao.pos end
	local alvoT = historicoChao[n].t - BASE_SEGURA.recuo
	for i = n, 1, -1 do
		if historicoChao[i].t <= alvoT then return historicoChao[i].pos end
	end
	return historicoChao[1].pos
end

-- Leva o corpo inteiro de volta e zera a queda
local function voltarAoChao(char, hum)
	local destino = pontoDeVolta()
	if not destino then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
		end
	end
	char:PivotTo(CFrame.new(destino + Vector3.new(0, 3, 0)))
	pcall(function()
		hum.PlatformStand = false
		hum.Sit = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
	ultimoChao = {pos = destino}
	historicoChao = {{t = os.clock(), pos = destino}}
	esperaBase = os.clock() + BASE_SEGURA.espera
end

local paradoDesde = nil -- desde quando você está parado na vertical
local contBase = 0      -- quantas checagens seguidas indicaram que você tocou na base

local function atualizarBases(char, hrp, hum)
	if not baseSegura then
		if not noLobby(hrp.Position) then criarBaseSegura(hrp.Position) end
		return
	end
	if noLobby(hrp.Position) then return end

	local topo = BASE_SEGURA.altura + BASE_SEGURA.tamanho.Y / 2
	local fundo = BASE_SEGURA.altura - (BASE_SEGURA.camadas + 1) * BASE_SEGURA.tamanho.Y - 20
	local baixo = pontoMaisBaixo(char, hrp)

	-- Durante o farm só age se você cair abaixo de todas as camadas
	if target then
		if hrp.Position.Y < fundo then
			target = nil
			voltarAoChao(char, hum)
			refresh()
		end
		return
	end

	-- Tocou OU atravessou a base: só volta se isso se repetir por alguns frames
	-- e se NÃO houver chão do mapa logo embaixo (andar perto da base não conta)
	local tocando = baixo <= topo + BASE_SEGURA.folga
	if tocando and hrp.Position.Y >= topo then
		raioParams.FilterDescendantsInstances = {char, baseParte}
		local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), raioParams)
		if hit and not baseSegura.todas[hit.Instance] and hit.Position.Y > topo + 0.1 then
			tocando = false
		end
	end
	if tocando and os.clock() > esperaBase then
		contBase += 1
		if contBase >= 3 then
			contBase = 0
			voltarAoChao(char, hum)
			return
		end
	else
		contBase = 0
	end

	-- Guarda a última parte do mapa em que você pisou.
	-- Conta como "pisou" se: o jogo diz que há chão, OU você ficou parado na
	-- vertical por um instante, OU há chão sólido logo abaixo.
	if baixo > topo + BASE_SEGURA.folga + 0.5 then
		local vy = hrp.AssemblyLinearVelocity.Y
		if math.abs(vy) < 0.5 then
			paradoDesde = paradoDesde or os.clock()
		else
			paradoDesde = nil
		end

		local noChao = hum.FloorMaterial ~= Enum.Material.Air
			or (paradoDesde ~= nil and os.clock() - paradoDesde > 0.25)

		if not noChao and math.abs(vy) < 3 then
			raioParams.FilterDescendantsInstances = {char, baseParte}
			local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), raioParams)
			if hit and not baseSegura.todas[hit.Instance] then
				local modelo = hit.Instance:FindFirstAncestorOfClass("Model")
				noChao = not (modelo and modelo:FindFirstChildOfClass("Humanoid"))
			end
		end

		if noChao then
			ultimoChao = {pos = hrp.Position}
			local agora = os.clock()
			local ult = historicoChao[#historicoChao]
			if not ult or agora - ult.t >= 0.1 then
				table.insert(historicoChao, {t = agora, pos = hrp.Position})
				while #historicoChao > 0 and agora - historicoChao[1].t > 5 do
					table.remove(historicoChao, 1)
				end
			end
		end
	end
end

-- ========== LÓGICA DO JOGO ==========
local startChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
startChar:WaitForChild("HumanoidRootPart")

-- Motivo pelo qual o jogador NÃO pode ser farmado (nil = pode)
local function motivoInvalido(plr)
	if not plr or plr == LocalPlayer then return "invalido" end
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = getHRP(char)
	if not hum or not hrp then return "saiu" end
	if hum.Health <= 0 then return "morto" end
	if noLobby(hrp.Position) then return "lobby" end
	if hrp.Position.Y < CONFIG.VOID_Y then return "void" end
	return nil
end

local function isValid(plr)
	return motivoInvalido(plr) == nil
end

-- Escolhe um alvo nos modos automáticos
local function escolherAlvo(hrp)
	local lista = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if isValid(p) and podeFarmarAuto(p) then
			table.insert(lista, p)
		end
	end
	if #lista == 0 then return nil end

	if randomOn then
		return lista[math.random(#lista)]
	end

	-- próximo: o mais perto dentro do raio
	local melhor, dist = nil, CONFIG.NEAR_RADIUS
	for _, p in ipairs(lista) do
		local d = (getHRP(p.Character).Position - hrp.Position).Magnitude
		if d < dist then melhor, dist = p, d end
	end
	return melhor
end

-- Cola em você no alvo (pelos pés): move o corpo INTEIRO e zera a velocidade.
-- Roda em 3 momentos por frame (antes da física, depois e antes de desenhar)
-- para o personagem não aparecer em outros lugares
local function seguirAlvo(char, hrp)
	local th = target and getHRP(target.Character)
	if not th then return end
	char:PivotTo(CFrame.new(th.Position + Vector3.new(0, CONFIG.OFFSET_Y, 0)))
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
end

-- Um passo do farm (todo frame). Funciona até se você estiver no lobby:
-- ao ligar o farm você vai direto para o alvo
local function farmar(hrp)
	if target then
		local motivo = motivoInvalido(target)
		if motivo then
			local th = getHRP(target.Character)
			local pos = (th and th.Position) or ultimaPosAlvo
			target = nil
			local char = hrp.Parent
			local hum = char:FindFirstChildOfClass("Humanoid")
			if motivo == "void" then
				-- alvo caiu no void: volta para a última parte do mapa
				if hum then voltarAoChao(char, hum) end
			elseif motivo == "morto" and tpAoMatar then
				-- opção ligada: vai para a posição salva
				char:PivotTo(CFrame.new(posSalva))
				hrp.AssemblyLinearVelocity = Vector3.zero
			elseif pos then
				-- opção desligada: sai de baixo da terra e fica em cima do mapa
				char:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			refresh()
			return
		end
		ultimaPosAlvo = getHRP(target.Character).Position
		seguirAlvo(hrp.Parent, hrp)
		return
	end

	if (randomOn or nearOn) and os.clock() >= proximaBusca then
		proximaBusca = os.clock() + 0.25
		target = escolherAlvo(hrp)
		if target then refresh() end
	end
end

-- Liga/desliga o farm manual em um jogador (3 toques no quadrado)
local function alternarFarm(plr)
	if target == plr then
		target = nil
	elseif isValid(plr) then
		target = plr
	end
	refresh()
end

-- Busca dos botões do jogo
local WORDS = {
	attack = {"ataque", "attack", "m1"},
	e = {"e"},
	r = {"r"},
}

local function findGameButton(kind)
	local cached = cache[kind]
	if cached and cached.Parent then return cached end

	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return nil end

	for _, o in ipairs(pg:GetDescendants()) do
		if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Visible then
			local t = string.lower(o.Text):gsub("%s", "")
			for _, w in ipairs(WORDS[kind]) do
				if t == w then
					local host = o:FindFirstAncestorWhichIsA("GuiButton") or o
					cache[kind] = host
					return host
				end
			end
		end
	end
	return nil
end

-- Apertar: só toque de celular
local function press(kind)
	local host = findGameButton(kind)
	if not host then return end

	if firesignal then
		for _, name in ipairs({"MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up"}) do
			pcall(function() firesignal(host[name]) end)
		end
	end

	local inset = GuiService:GetGuiInset()
	local p = host.AbsolutePosition + host.AbsoluteSize / 2 + inset
	VIM:SendTouchEvent(7, 0, p.X, p.Y)
	task.wait(0.03)
	VIM:SendTouchEvent(7, 2, p.X, p.Y)
end

-- Loop dos botões automáticos (Ataque / E / R)
task.spawn(function()
	while vivo and task.wait(CONFIG.SKILL_DELAY) do
		if auto.attack then press("attack") end
		if auto.e then press("e") end
		if auto.r then press("r") end
	end
end)

