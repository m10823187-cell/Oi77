busca:GetPropertyChangedSignal("Text"):Connect(function()
	local q = string.lower(busca.Text):match("^%s*(.-)%s*$")
	for _, sec in ipairs(secoes) do
		sec.frame.Visible = (q == "") or (string.find(string.lower(sec.nome), q, 1, true) ~= nil)
	end
end)

-- ---- Salvar (fica logo abaixo do perfil) ----
local salvarBtn = novoBotao(2, pPerfil, "Salvar configuração", COR.verde, "salvar", "💾")
salvarBtn.MouseButton1Click:Connect(function()
	if not writefile then
		status("Seu executor não permite salvar arquivos.")
		return
	end
	local ok = pcall(function()
		writefile(ARQUIVO_PERFIL, HttpService:JSONEncode({
			perfil = LocalPlayer.Name,
			fundo = fundoAtual,
			icones = iconesOn,
			quadros = modoQuadros,
			personagem = mostrarPersonagem,
		}))
	end)
	status(ok and ("✅ Configuração salva no perfil " .. LocalPlayer.Name)
		or "Não foi possível salvar a configuração.")
end)

-- Ao abrir o menu: carrega a configuração salva do perfil e mostra de quem é
local function carregarConfig()
	local ok, dados = pcall(function()
		if not (isfile and readfile) or not isfile(ARQUIVO_PERFIL) then return nil end
		return HttpService:JSONDecode(readfile(ARQUIVO_PERFIL))
	end)
	if ok and type(dados) == "table" then
		if dados.fundo then aplicarFundo(dados.fundo) end
		if dados.quadros == "normal" or dados.quadros == "proximos" then
			aplicarModoQuadros(dados.quadros)
		end
		if dados.personagem then definirPersonagem(true) end
		status("✅ Configuração carregada do perfil " .. tostring(dados.perfil or LocalPlayer.Name))
		if dados.icones then
			task.defer(function() aplicarPersonalizacao(true, true) end)
		end
	else
		status("Nenhuma configuração salva neste perfil.")
	end
end
carregarConfig()

-- ========== QUADRADOS DOS JOGADORES ==========
-- Pinta borda, nome e botão FARM: verde = farmando | dourado = ADM | azul = normal
-- No lobby o nome vira "LOBBY" em amarelo (a foto fica normal)
local function pintarCartao(plr, c)
	local on = (plr == target)
	local prox = (modoQuadros == "proximos") and (c.prox or 0) or 0
	local corBorda
	if on then
		corBorda = COR.on
	elseif prox == 2 then
		corBorda = COR.verdeForte
	elseif prox == 1 then
		corBorda = COR.verdeFraco
	else
		corBorda = c.adm and COR.ouro or COR.azul
	end
	c.quad.BorderColor3 = corBorda
	if c.lobby then
		c.nome.Text = "LOBBY"
		c.nome.TextColor3 = COR.ouro
	else
		c.nome.Text = textoNome(plr)
		c.nome.TextColor3 = on and COR.on or COR.texto
	end
	local f = podeFarmarAuto(plr)
	c.btn.Text = f and "FARM ON" or "FARM OFF"
	c.btn.BackgroundColor3 = f and COR.on or COR.cinza
end

-- Layout do quadrado: normal/próximos = foto centralizada; personagem = foto + personagem ao lado
local function ajustarCartao(c)
	if mostrarPersonagem then
		c.foto.Size = UDim2.new(0, 44, 0, 44)
		c.foto.Position = UDim2.new(0, 6, 0, 5)
		c.caixa.Visible = true
		c.nome.Size = UDim2.new(1, -8, 0, CARD.altura - 58)
		c.nome.Position = UDim2.new(0, 4, 0, 54)
	else
		c.foto.Size = UDim2.new(0, CARD.foto, 0, CARD.foto)
		c.foto.Position = UDim2.new(0.5, -CARD.foto / 2, 0, 4)
		c.caixa.Visible = false
		c.nome.Size = UDim2.new(1, -4, 0, CARD.altura - CARD.foto - 9)
		c.nome.Position = UDim2.new(0, 2, 0, CARD.foto + 6)
	end
end

-- Mostra o personagem: a figura quando tem ID, senão o título
local aplicarPersonagem
do
	local cacheDecal = {}

	-- Se o ID for de "Decal", descobre o ID da imagem que está dentro dele
	local function resolverDecal(id)
		id = idTexto(id)
		if cacheDecal[id] ~= nil then return cacheDecal[id] or nil end
		local ok, tex = pcall(function()
			local objs = game:GetObjects("rbxassetid://" .. id)
			local o = objs and objs[1]
			if not o then return nil end
			if o:IsA("Decal") or o:IsA("Texture") then return o.Texture end
			local d = o:FindFirstChildWhichIsA("Decal", true)
			return d and d.Texture or nil
		end)
		cacheDecal[id] = (ok and tex and tex ~= "") and tex or false
		return cacheDecal[id] or nil
	end

	-- Mostra o personagem: a figura quando tem ID, senão o título.
	-- A figura é insistente: se não carregar, troca de formato a cada 3 segundos
	-- (miniatura, imagem direta, Decal) até carregar. Enquanto isso o título fica à mostra.
	aplicarPersonagem = function(c, pers)
		local chave = pers and pers.nome or "?"
		if c.persChave == chave then return end
		c.persChave = chave
		if pers and pers.icone then
			c.tituloLbl.Text = pers.nome
			c.tituloLbl.Visible = true
			c.iconeImg.Image = miniatura(pers.icone, 150)
			c.iconeImg.Visible = true
			task.spawn(function()
				local formato, desde = 1, os.clock()
				while c.persChave == chave and c.iconeImg.Parent do
					if c.iconeImg.IsLoaded and c.iconeImg.Image ~= "" then
						c.tituloLbl.Visible = false
						return
					end
					if os.clock() - desde > (formato == 1 and 6 or 3) then
						desde = os.clock()
						formato = formato % 3 + 1
						if formato == 1 then
							c.iconeImg.Image = miniatura(pers.icone, 150)
						elseif formato == 2 then
							c.iconeImg.Image = "rbxassetid://" .. idTexto(pers.icone)
						else
							local tex = resolverDecal(pers.icone)
							if tex then c.iconeImg.Image = tex end
						end
					end
					task.wait(0.25)
				end
			end)
		else
			c.iconeImg.Visible = false
			c.tituloLbl.Text = pers and pers.nome or "?"
			c.tituloLbl.Visible = true
		end
	end
end

local function montarCartao(plr, pai)
	local adm = ehAdm(plr)

	-- Célula: quadrado em cima + botão FARM embaixo
	local cel = criar("Frame", {
		Name = plr.Name,
		BackgroundTransparency = 1,
	}, pai)

	-- Quadrado de cantos retos com borda de verdade (sem corte)
	local quad = criar("TextButton", {
		Size = UDim2.new(1, 0, 0, CARD.altura),
		BackgroundColor3 = COR.card,
		BorderSizePixel = CARD.borda,
		BorderMode = Enum.BorderMode.Inset,
		BorderColor3 = adm and COR.ouro or COR.azul,
		Text = "",
		AutoButtonColor = false,
	}, cel)

	local foto = criar("ImageLabel", {
		Size = UDim2.new(0, CARD.foto, 0, CARD.foto),
		Position = UDim2.new(0.5, -CARD.foto / 2, 0, 4),
		BackgroundColor3 = COR.fundo,
		BorderSizePixel = 0,
		Image = "",
	}, quad)

	local nome = criar("TextLabel", {
		Size = UDim2.new(1, -4, 0, CARD.altura - CARD.foto - 9),
		Position = UDim2.new(0, 2, 0, CARD.foto + 6),
		BackgroundTransparency = 1,
		Text = textoNome(plr),
		TextColor3 = COR.texto,
		TextScaled = true,
		Font = Enum.Font.SourceSansBold,
	}, quad)
	criar("UITextSizeConstraint", {MaxTextSize = 10}, nome)

	-- Caixa do personagem (só aparece no modo Personagem): figura ou título
	local caixa = criar("Frame", {
		Size = UDim2.new(0, 44, 0, 44),
		Position = UDim2.new(1, -50, 0, 5),
		BackgroundColor3 = COR.fundo,
		BorderSizePixel = 0,
		Visible = false,
	}, quad)
	local iconeImg = criar("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Visible = false,
		ZIndex = 2,
	}, caixa)
	local tituloLbl = criar("TextLabel", {
		Size = UDim2.new(1, -4, 1, -4),
		Position = UDim2.new(0, 2, 0, 2),
		BackgroundTransparency = 1,
		Text = "?",
		TextColor3 = COR.ouro,
		TextScaled = true,
		TextWrapped = true,
		Font = Enum.Font.SourceSansBold,
	}, caixa)
	criar("UITextSizeConstraint", {MaxTextSize = 11, MinTextSize = 5}, tituloLbl)

	-- Botão FARM embaixo do quadrado
	local btn = criar("TextButton", {
		Size = UDim2.new(1, 0, 0, CARD.botao),
		Position = UDim2.new(0, 0, 0, CARD.altura + 3),
		BackgroundColor3 = COR.on,
		BorderSizePixel = 0,
		Text = "FARM ON",
		TextColor3 = COR.texto,
		TextSize = 10,
		Font = Enum.Font.SourceSansBold,
		AutoButtonColor = false,
	}, cel)

	carregarFoto(plr, foto)

	btn.Activated:Connect(function()
		farmavel[plr] = not podeFarmarAuto(plr)
		-- desligou: para o farm nele, se estiver farmando
		if not farmavel[plr] and target == plr then target = nil end
		refresh()
	end)

	local toques = {}
	quad.Activated:Connect(function()
		efeitoClique(quad)

		-- ADM: 1 toque liga o farm, 1 toque desliga (e volta para a posição salva)
		if adm then
			if target == plr then
				target = nil
				local char = LocalPlayer.Character
				local hrp = getHRP(char)
				if hrp then
					char:PivotTo(CFrame.new(posSalva))
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
				refresh()
			else
				alternarFarm(plr)
			end
			return
		end

		-- Outros jogadores: 3 toques seguidos = liga/desliga o farm
		local agora = os.clock()
		table.insert(toques, agora)
		while #toques > 0 and agora - toques[1] > TOQUES.tempo do
			table.remove(toques, 1)
		end
		if #toques >= TOQUES.quantidade then
			toques = {}
			alternarFarm(plr)
		end
	end)

	local c = {
		cel = cel, quad = quad, nome = nome, btn = btn, foto = foto,
		caixa = caixa, iconeImg = iconeImg, tituloLbl = tituloLbl,
		adm = adm, lobby = false, prox = 0,
	}
	ajustarCartao(c)
	pintarCartao(plr, c)
	return c
end

-- Cada jogador tem um quadrado no menu principal.
-- Os ADMs têm um segundo quadrado na página TELEPORTE.
local function criarCartao(plr)
	if plr == LocalPlayer or cartoes[plr] then return end
	farmavel[plr] = not ehAdm(plr) -- jogador liga, ADM desliga
	local lista = {montarCartao(plr, grade)}
	if ehAdm(plr) then
		table.insert(lista, montarCartao(plr, gradeAdm))
		qtdAdm += 1
		cabAdm.Visible = true
	end
	cartoes[plr] = lista
end

local function removerCartao(plr)
	local lista = cartoes[plr]
	if lista then
		for _, c in ipairs(lista) do c.cel:Destroy() end
		cartoes[plr] = nil
		farmavel[plr] = nil
		if ehAdm(plr) then
			qtdAdm -= 1
			cabAdm.Visible = qtdAdm > 0
		end
	end
	if target == plr then target = nil end
end

-- Muda o tamanho das células e o layout de cada quadrado conforme o modo
ajustarLayoutModo = function()
	local largura = mostrarPersonagem and CARD.larguraPers or CARD.largura
	for _, g in ipairs({grade, gradeAdm}) do
		local lay = g:FindFirstChildOfClass("UIGridLayout")
		if lay then lay.CellSize = UDim2.new(0, largura, 0, CEL_ALTURA) end
	end
	for _, lista in pairs(cartoes) do
		for _, c in ipairs(lista) do ajustarCartao(c) end
	end
end

for _, p in ipairs(Players:GetPlayers()) do criarCartao(p) end
ajustarLayoutModo()
ligar(Players.PlayerAdded, criarCartao)
ligar(Players.PlayerRemoving, removerCartao)

-- ========== VISUAL ON/OFF ==========
refresh = function()
	swRandom.set(randomOn)
	swNear.set(nearOn)
	for plr, lista in pairs(cartoes) do
		for _, c in ipairs(lista) do pintarCartao(plr, c) end
	end
end

-- Marca "LOBBY" no quadrado de quem está na base do lobby
task.spawn(function()
	while vivo and task.wait(0.5) do
		for plr, lista in pairs(cartoes) do
			local hrp = getHRP(plr.Character)
			local dentro = (hrp ~= nil) and noLobby(hrp.Position)
			for _, c in ipairs(lista) do
				if dentro ~= c.lobby then
					c.lobby = dentro
					pintarCartao(plr, c)
				end
			end
		end
	end
end)

-- Modo "Próximos": quem está perto sobe para os primeiros quadrados, borda verde forte/fraca
task.spawn(function()
	while vivo and task.wait(0.4) do
		if modoQuadros == "proximos" then
			local meu = getHRP(LocalPlayer.Character)
			for plr, lista in pairs(cartoes) do
				local hrp = getHRP(plr.Character)
				local d = (meu and hrp) and (hrp.Position - meu.Position).Magnitude or math.huge
				local prox = (d <= PROX.forte and 2) or (d <= PROX.fraco and 1) or 0
				for _, c in ipairs(lista) do
					c.cel.LayoutOrder = (d == math.huge) and 100000 or math.floor(d)
					if c.prox ~= prox then
						c.prox = prox
						pintarCartao(plr, c)
					end
				end
			end
		end
	end
end)

-- Personagem de cada jogador: atualiza ao ligar o botão e depois a cada 1 segundo
atualizarPersonagens = function()
	for plr, lista in pairs(cartoes) do
		local pers = descobrirPersonagem(plr)
		for _, c in ipairs(lista) do aplicarPersonagem(c, pers) end
	end
end

task.spawn(function()
	while vivo and task.wait(1) do
		if mostrarPersonagem then atualizarPersonagens() end
	end
end)

-- ========== BOTÕES ==========
-- Teleportar para a posição salva
tpBtn.MouseButton1Click:Connect(function()
	local hrp = getHRP(LocalPlayer.Character)
	if hrp then
		target = nil
		hrp.Parent:PivotTo(CFrame.new(posSalva))
		hrp.AssemblyLinearVelocity = Vector3.zero
		refresh()
	end
end)

-- Fechar: desliga tudo e apaga as bases
local function fecharTudo()
	vivo = false
	target = nil
	auto.attack, auto.e, auto.r = false, false, false
	for _, c in ipairs(conexoes) do c:Disconnect() end
	if baseParte then baseParte:Destroy() end
	removerBaseSegura()
	gui:Destroy()
end
btnFechar.MouseButton1Click:Connect(fecharTudo)

-- Interruptor remoto em tempo real: se o status.txt virar "off", o menu some
task.spawn(function()
	local ciclos = 0
	while vivo do
		task.wait(20)
		ciclos += 1
		if vivo and ciclos % 3 == 0 and desligadoRemoto() then
			print("Script desativado pelo criador.")
			fecharTudo()
			break
		end
	end
end)

-- ========== LOOP PRINCIPAL E NASCIMENTO ==========
-- Toda vez que você nasce: cria a base do lobby e limpa a base de segurança
-- Reiniciar ao levar dano: se a vida cair, zera a vida (reinicia)
local function vigiarDano(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local ultimaVida = hum.Health
	hum.HealthChanged:Connect(function(vida)
		if reiniciarDano and vida > 0 and vida < ultimaVida then
			hum.Health = 0
		end
		ultimaVida = vida
	end)
end

-- Ao renascer com "reiniciar ao dano" ligado e posição marcada,
-- você nasce na posição marcada (não no lobby)
local function nascerNaPosicao(char)
	if not (reiniciarDano and posMarcada) then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end
	local firmes = 0
	for _ = 1, 25 do
		if not vivo or not hrp.Parent then return end
		if (hrp.Position - posSalva).Magnitude > 30 then
			char:PivotTo(CFrame.new(posSalva))
			firmes = 0
		else
			firmes += 1
			if firmes >= 4 then return end
		end
		task.wait(0.1)
	end
end

criarBase()
task.spawn(vigiarDano, startChar)
ligar(LocalPlayer.CharacterAdded, function(char)
	criarBase()
	removerBaseSegura() -- será criada de novo ao sair do lobby
	task.spawn(vigiarDano, char)
	task.spawn(nascerNaPosicao, char)
end)

-- Todo frame: bases + farm
ligar(RunService.Heartbeat, function()
	if not vivo then return end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = getHRP(char)
	if not hum or not hrp or hum.Health <= 0 then return end
	atualizarBases(char, hrp, hum)
	farmar(hrp)
end)

-- Segunda vigia, antes da física de cada frame: pega a queda mais cedo
ligar(RunService.Stepped, function()
	if not vivo then return end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = getHRP(char)
	if not hum or not hrp or hum.Health <= 0 then return end
	atualizarBases(char, hrp, hum)
	if target then seguirAlvo(char, hrp) end
end)

-- Terceira passada, logo antes de desenhar o frame: sem "vultos" na tela
ligar(RunService.RenderStepped, function()
	if not vivo or not target then return end
	local char = LocalPlayer.Character
	local hrp = getHRP(char)
	if hrp then seguirAlvo(char, hrp) end
end)

-- Pré-carga em segundo plano: figuras dos personagens, fundos e ícones
task.spawn(function()
	local urls = {}
	for _, pers in ipairs(PERSONAGENS) do
		if pers.icone then table.insert(urls, miniatura(pers.icone, 150)) end
	end
	for _, t in ipairs(FUNDOS) do
		for _, id in ipairs(t.ids) do table.insert(urls, miniatura(id, 150)) end
	end
	preCarregar(urls)

	urls = {}
	for _, id in pairs(ICONES) do table.insert(urls, miniatura(id, 150)) end
	preCarregar(urls)

	urls = {}
	for _, t in ipairs(FUNDOS) do
		for _, id in ipairs(t.ids) do table.insert(urls, miniatura(id, 420)) end
	end
	preCarregar(urls)
end)

mostrarPagina("menu")
refresh()
