do
	local barraModo = criar("Frame", {
		Name = "BarraModo",
		Size = UDim2.new(1, -10, 0, 26),
		Position = UDim2.new(0, 5, 0, 4),
		BackgroundTransparency = 1,
	}, corpo)
	grade.Position = UDim2.new(0, 5, 0, 34)
	grade.Size = UDim2.new(1, -10, 1, -38)

	local btnPers = criar("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = COR.card,
		BorderSizePixel = 0,
		Text = "🦸 Personagem: OFF",
		TextColor3 = COR.texto,
		TextSize = 12,
		Font = Enum.Font.SourceSansBold,
		AutoButtonColor = false,
	}, barraModo)
	arredondar(btnPers, 8)
	local strPers = criar("UIStroke", {Color = COR.cinza, Thickness = 1.5}, btnPers)

	definirPersonagem = function(v)
		mostrarPersonagem = v
		btnPers.Text = v and "🦸 Personagem: ON" or "🦸 Personagem: OFF"
		btnPers.BackgroundColor3 = v and Color3.fromRGB(0, 70, 40) or COR.card
		strPers.Color = v and COR.on or COR.cinza
		if ajustarLayoutModo then ajustarLayoutModo() end
		if v and atualizarPersonagens then task.defer(atualizarPersonagens) end
	end
	btnPers.MouseButton1Click:Connect(function() definirPersonagem(not mostrarPersonagem) end)
