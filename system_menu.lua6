local paginas = {}
local titulos = {menu = TITULO, config = "MENU DE ATAQUE", tele = "TELEPORTE", ajustes = "CONFIGURAÇÃO"}

local function criarLista(nome, emGrade)
	local lista = criar("ScrollingFrame", {
		Name = nome,
		Size = UDim2.new(1, -10, 1, -8),
		Position = UDim2.new(0, 5, 0, 4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
	}, corpo)
	if emGrade then
		-- folga em cima e embaixo: a borda dos quadrados não fica cortada
		criar("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
		}, lista)
		criar("UIGridLayout", {
			CellSize = UDim2.new(0, CARD.largura, 0, CEL_ALTURA),
			CellPadding = UDim2.new(0, CARD.espaco, 0, CARD.espaco),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}, lista)
	else
		criar("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}, lista)
	end
	paginas[nome] = lista
	return lista
end

