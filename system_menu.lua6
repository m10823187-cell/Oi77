arredondar(carBarra, 5)

local carPct = criar("TextLabel", {
	Size = UDim2.new(1, 0, 0, 16),
	Position = UDim2.new(0, 0, 0.5, 10),
	BackgroundTransparency = 1,
	Text = "0%",
	TextColor3 = COR.sub,
	TextSize = 11,
	Font = Enum.Font.SourceSansBold,
	Visible = false,
	ZIndex = 51,
}, carregando)

local animando = false
local function animarCarregamento(aoMeio)
	if animando then return end
	animando = true
	task.spawn(function()
		carBarra.Size = UDim2.new(0, 0, 1, 0)
		carPct.Text = "0%"
		carregando.BackgroundTransparency = 1
		carregando.Visible = true
		TweenService:Create(carregando, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
		task.wait(0.3)
		carTexto.Visible, carTrilho.Visible, carPct.Visible = true, true, true

		local passos = 20
		for i = 1, passos do
			TweenService:Create(carBarra, TweenInfo.new(0.07), {Size = UDim2.new(i / passos, 0, 1, 0)}):Play()
			carPct.Text = math.floor(i / passos * 100) .. "%"
			if i == 12 and aoMeio then pcall(aoMeio) end
			task.wait(0.07)
		end

		task.wait(0.15)
		carTexto.Visible, carTrilho.Visible, carPct.Visible = false, false, false
		TweenService:Create(carregando, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
		task.wait(0.35)
		carregando.Visible = false
		animando = false
	end)
end

